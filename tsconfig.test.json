{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"sourceMap": false,
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": ["es2023", "dom"],
