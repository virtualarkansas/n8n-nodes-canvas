RAILS_ENV=development
CANVAS_DATABASE_HOST=127.0.0.1
POSTGRES_PASSWORD=sekret
ENCRYPTION_KEY=facdd3a131ddd8988b14f6e4e01039c93cfa0160
CANVAS_LMS_ADMIN_EMAIL=admin@example.com
CANVAS_LMS_ADMIN_PASSWORD=CanvasAdminPass123
CANVAS_LMS_ACCOUNT_NAME=Battery Test District
CANVAS_LMS_STATS_COLLECTION=opt_out
RAILS_LOG_LEVEL=info
# Every `docker exec ... rails runner` (seed, bootstrap, test helpers) must be a process of
# its own. Canvas' Spring preloader would fork them from one long-lived parent whose cached
# settings are as old as that parent, and each would then create a "default developer key"
# of its own, after which the web server processes disagree about which key is the default.
DISABLE_SPRING=1
