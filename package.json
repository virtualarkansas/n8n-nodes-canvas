{
	"name": "@kyancey-va/n8n-nodes-canvas",
	"version": "0.1.0-beta.3",
	"description": "n8n community nodes for Canvas LMS - full API coverage with 92 resources",
	"license": "MIT",
	"homepage": "https://github.com/virtualarkansas/n8n-nodes-canvas",
	"keywords": [
		"n8n-community-node-package",
		"canvas",
		"canvas-lms",
		"instructure",
		"lms",
		"education"
	],
	"author": {
		"name": "Kyle Yancey",
		"email": "kyancey@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/virtualarkansas/n8n-nodes-canvas.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/CanvasApi.credentials.js",
			"dist/credentials/CanvasOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/Canvas/Canvas.node.js",
			"dist/nodes/Canvas/CanvasTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/node": "^20.0.0",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
